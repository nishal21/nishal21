n glow"},{"t":34.3,"end":37.84,"section":"Chorus","text":"Every week is a bar, every day is a note"},{"t":37.84,"end":40.78,"section":"Chorus","text":"Turn it up loud, let the bass line roll"},{"t":40.78,"end":44.36,"section":"Chorus","text":"Run it back tomorrow, here we go"},{"t":44.36,"end":47.76,"section":"Verse 2","text":"Right now I'm deep in firstpr and Neko"},{"t":47.76,"end":51.16,"section":"Verse 2","text":"sixty-five repos, JavaScript most of all"},{"t":51.16,"end":54.78,"section":"Verse 2","text":"Cut it like an A M V, every frame in place"},{"t":54.78,"end":58.12,"section":"Verse 2","text":"Mix it like a mashup, every verse in rhyme"},{"t":58.12,"end":61.8,"section":"Breakdown","text":"Light weeks play low, heavy weeks play loud"},{"t":65.26,"end":68.58,"section":"Chorus","text":"Light up the grid, let the green glow"},{"t":68.58,"end":72.14,"section":"Chorus","text":"Every week is a bar, every day is a note"},{"t":72.14,"end":75.1,"section":"Chorus","text":"Turn it up loud, let the bass line roll"},{"t":75.1,"end":79.26,"section":"Chorus","text":"Run it back tomorrow, here we go"},{"t":81.74,"end":86.38,"section":"Outro","text":"That was nine hundred twenty-two contributions from Nishal."},{"t":86.38,"end":90.0,"section":"Outro","text":"Tomorrow the numbers change, and the song does too"}],"peaks":[0.979,0.64,0.339,0.278,0.216,0.174,0.135,0.106,0.089,0.081,0.642,0.356,0.551,0.354,0.555,0.559,0.494,0.418,0.348,0.324,0.322,0.787,0.729,0.167,0.783,0.454,0.479,0.822,0.909,0.783,1.0,0.777,0.519,0.609,0.722,0.582,0.633,0.675,0.79,0.783,0.941,0.693,0.569,0.457,0.398,0.653,0.476,0.855,0.331,0.335,0.527,0.747,0.391,0.34,0.575,0.627,0.822,0.712,0.781,0.701,0.85,0.592,0.863,0.605,0.699,0.143,0.545,0.643,0.565,0.835,0.759,0.785,0.925,0.738,0.842,0.471,0.623,0.798,0.729,0.578,0.844,0.541,0.285,0.603,0.789,0.674,0.775,0.597,0.734,0.749,0.674,0.662,0.521,0.851,0.657,0.742,0.563,0.713,0.644,0.65,0.675,0.648,0.611,0.595,0.747,0.521,0.631,0.524,0.66,0.442,0.547,0.646,0.