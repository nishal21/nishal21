":"October ran hot with one hundred forty-five on the sheet"},{"t":24.14,"end":27.52,"section":"Verse 1","text":"ten days straight, no breaks along the way"},{"t":27.52,"end":30.16,"section":"Chorus","text":"Light up the grid, let the green glow"},{"t":30.16,"end":33.86,"section":"Chorus","text":"Every week is a bar, every day is a note"},{"t":34.38,"end":37.72,"section":"Chorus","text":"Turn it up loud, let the bass line roll"},{"t":37.72,"end":40.84,"section":"Chorus","text":"Run it back tomorrow, here we go"},{"t":41.34,"end":44.7,"section":"Verse 2","text":"Right now I'm deep in motion skill and Neko docs"},{"t":44.82,"end":47.64,"section":"Verse 2","text":"sixty-four repos, JavaScript most of all"},{"t":47.64,"end":51.06,"section":"Verse 2","text":"Cut it like an A M V, every frame in place"},{"t":51.06,"end":54.38,"section":"Verse 2","text":"Mix it like a mashup, every verse in rhyme"},{"t":58.24,"end":61.68,"section":"Breakdown","text":"Light weeks play low, heavy weeks play loud"},{"t":63.56,"end":66.14,"section":"Chorus","text":"Light up the grid, let the green glow"},{"t":66.14,"end":69.92,"section":"Chorus","text":"Every week is a bar, every day is a note"},{"t":70.6,"end":74.0,"section":"Chorus","text":"Turn it up loud, let the bass line roll"},{"t":74.0,"end":76.88,"section":"Chorus","text":"Run it back tomorrow, here we go"},{"t":78.04,"end":82.96,"section":"Outro","text":"That was eight hundred eighty-six contributions from Nishal."},{"t":82.96,"end":88.96,"section":"Outro","text":"Tomorrow the numbers change, and the song does too"}],"peaks":[0.441,0.302,0.242,0.178,0.147,0.123,0.089,0.442,0.76,0.319,0.063,0.151,0.158,0.254,0.186,0.368,0.301,0.266,0.234,0.184,0.138,0.621,1.0,0.408,0.628,0.647,0.407,0.064,0.231,0.169,0.436,0.374,0.304,0.257,0.214,0.202,0.159,0.125,0.105,0.475,0.788,0.712,0.463,0.688,0.515,0.423,0.293,0.24,0.202,0.185,0.617,0.317,0.484,0.322,0.61,0.189,0.121,0.217,0.488,0.725,0.738,0.681,0.571,0.686,0.513,0.715,0.47,0.656,0.764,0.652,0